{
  "name": "eeo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 --cache --cache-location .eslintcache",
    "verify": "pnpm run check:pilot-routes && pnpm run check:pilot-hub-routes && pnpm run check:corridor-section-routes && pnpm run check:temporal-dormancy && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "check:temporal-dormancy": "node scripts/check-temporal-profile-imports.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:pilot-routes": "node scripts/check-pilot-routes.mjs",
    "check:pilot-hub-routes": "node scripts/check-pilot-hub-routes.mjs",
    "check:corridor-section-routes": "node scripts/check-corridor-section-routes.mjs",
    "check:brand-assets": "node scripts/verify-brand-assets.mjs",
    "sync:corridor-docs": "node scripts/sync-corridor-docs-mirror.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "next": "15.5.27",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
